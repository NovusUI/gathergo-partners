# Omit this when /api/v1 is forwarded to the backend by the website host.
VITE_API_BASE_URL=
# Local Vite development proxy; do not include /api/v1 here.
GATHERGO_API_PROXY_TARGET=http://127.0.0.1:4000

# Supply release identifiers at build time to generate dist/.well-known files.
PUBLIC_ANDROID_PACKAGE=com.gathergo.dev
PUBLIC_ANDROID_SHA256_CERT_FINGERPRINTS=
PUBLIC_IOS_APP_ID=
